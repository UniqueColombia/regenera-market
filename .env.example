# Seregenera — variables de entorno
# Copia este archivo a .env.local y llena los valores. .env.local NO se versiona.

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Se obtienen en el panel del proyecto: Settings → API.
# La clave anon es pública por diseño: la seguridad la dan las políticas RLS
# de supabase/migrations/0001_init.sql, no el secreto de la clave.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave de servicio. NUNCA se expone al navegador ni se prefija con NEXT_PUBLIC_.
# Solo la usan tareas de servidor que deben saltarse RLS (importar el catálogo,
# confirmar pagos, asignar roles).
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Pago en línea: BOLD (pasarela)
# ---------------------------------------------------------------------------
# Las dos llaves salen del panel de BOLD (panel.bold.co → Integraciones →
# Llaves de integración, sección «Botón de pagos»). Con las dos puestas, el
# pedido muestra el botón «Paga en línea» (tarjeta, PSE, Nequi…); sin ellas, solo
# llave Bre-B y transferencia, confirmadas a mano en /admin/ordenes.
# Ver src/lib/payments.ts.
#
# BOLD_LLAVE_IDENTIDAD va en el botón del navegador (es pública por diseño), pero
# se lee en el servidor igual que la secreta. BOLD_LLAVE_SECRETA firma cada cobro
# y verifica el webhook: NUNCA con prefijo NEXT_PUBLIC_.
#
# El webhook se configura en el mismo panel: https://<dominio>/api/webhooks/bold
#
# BOLD_MODO_PRUEBAS=1 verifica el webhook con la llave vacía, como pide BOLD en
# pruebas. Se ignora en el entorno Production de Vercel: ahí sería aceptar
# avisos de pago que cualquiera puede firmar.
BOLD_LLAVE_IDENTIDAD=
BOLD_LLAVE_SECRETA=
BOLD_MODO_PRUEBAS=

# ---------------------------------------------------------------------------
# Pago con llave Bre-B y por transferencia
# ---------------------------------------------------------------------------
# Lo que ve quien compra en su pedido para pagar sin pasarela. Van aquí y no en
# el código porque el repositorio es público: una cuenta publicada en GitHub es
# la materia prima de una página de pago falsa. Vacías, el pedido dice a qué
# correo escribir para recibir los datos.
#
# PAGO_LLAVE_BREB: la llave de la cuenta (celular, correo, documento o
# alfanumérica). PAGO_TITULAR: si se deja vacío, la razón social de
# src/lib/legal.ts. PAGO_CORREO_COMPROBANTES: si se deja vacío, el de contacto.
PAGO_LLAVE_BREB=
PAGO_BANCO=
PAGO_TIPO_CUENTA=
PAGO_NUMERO_CUENTA=
PAGO_TITULAR=
PAGO_NIT=
PAGO_CORREO_COMPROBANTES=

# ---------------------------------------------------------------------------
# Correo transaccional (SMTP)
# ---------------------------------------------------------------------------
# Los correos que manda la APLICACIÓN: hoy el respaldo de una postulación de
# /vender, mañana el aviso de una orden. Los correos de ACCESO no salen de aquí:
# esos los manda Supabase con sus propias plantillas, configuradas en el panel y
# copiadas en plantillas-correo/.
#
# Son las mismas credenciales que ya tiene Supabase en Authentication → SMTP
# Settings. No hace falta abrir cuenta en ningún servicio nuevo: si el acceso
# funciona, esto funciona.
#
# Mientras estén vacías, la aplicación escribe el correo en la consola del
# servidor y sigue adelante. La postulación se guarda igual — que falle un
# correo de cortesía no puede deshacer un alta que ya ocurrió.
#
# SMTP_REMITENTE tiene que ser la cuenta que autentica o un alias verificado
# suyo: Gmail reescribe o rechaza cualquier otro From. Sin él se usa SMTP_USER.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_REMITENTE=

# ---------------------------------------------------------------------------
# Aplicación
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secreto con el que se firma la cookie que lleva el reloj de inactividad de la
# sesión (src/lib/inactividad.ts). Cualquier cadena aleatoria larga:
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Es opcional. Sin él, la sesión sigue caducando a las 48 horas sin uso —que es
# lo que protege al computador compartido— pero la cookie va sin firmar y se
# puede falsificar. Con él, quien copie las cookies de sesión de otro no puede
# fabricarse la de actividad, y la sesión robada muere en el primer corte.
#
# Ponerlo o cambiarlo **cierra la sesión de todo el mundo una vez**: las cookies
# firmadas con el valor anterior dejan de validar. No es un fallo.
SESION_SECRETO=

# ---------------------------------------------------------------------------
# MercadoLibre (opcional — solo para scripts/prospectar.mts)
# ---------------------------------------------------------------------------
# Desde 2024 la búsqueda de MercadoLibre ya no admite acceso anónimo: responde
# 403 sin token. Se registra una app propia (gratis) en
# developers.mercadolibre.com.co y se usa el flujo client_credentials, que no
# necesita que ningún usuario autorice nada. Ver la skill prospeccion-proveedores.
#
# Mientras estén vacías, el prospector salta la señal comercial y avisa. No
# afecta a la aplicación: nada en src/ las lee.
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Token personal de Supabase (opcional — solo para administrar la base)
# ---------------------------------------------------------------------------
# Se genera en https://supabase.com/dashboard/account/tokens. NO lo usa la
# aplicación: sirve para aplicar migraciones y correr consultas contra el
# proyecto desde esta máquina, por la Management API o el CLI (`npx supabase`),
# sin necesidad de la contraseña de la base.
#
# Es una llave de tu cuenta entera, no de este proyecto: quien la tenga puede
# tocar cualquier proyecto de Supabase tuyo. Va en .env.local y en ningún otro
# sitio.
SUPABASE_ACCESS_TOKEN=
